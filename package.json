{
  "name": "bookrate",
  "private": true,
  "version": "0.0.0",
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=22.22.1"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "dev": "turbo run dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "turbo": "^2.10.12",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "^16.4.5",
    "prisma": "7.10.1"
  }
}
